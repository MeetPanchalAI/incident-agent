{
  "services": {
    "checkout-api": {
      "upstream": ["orders-db", "payment-service"],
      "downstream": ["web-frontend"]
    },
    "payment-service": {
      "upstream": ["payment-gateway", "orders-db"],
      "downstream": ["checkout-api"]
    },
    "payment-gateway": {
      "upstream": [],
      "downstream": ["payment-service"]
    },
    "orders-db": {
      "upstream": [],
      "downstream": ["checkout-api", "payment-service"]
    },
    "web-frontend": {
      "upstream": ["checkout-api"],
      "downstream": []
    }
  },
  "metrics": {
    "error_rate": {"unit": "fraction", "baseline": 0.005, "noise": 0.002, "min_delta": 0.01},
    "latency_p95_ms": {"unit": "ms", "baseline": 90, "noise": 15, "min_delta": 100},
    "request_rate": {"unit": "requests/min", "baseline": 240, "noise": 20, "min_delta": 10}
  }
}
