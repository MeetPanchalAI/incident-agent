# Every tunable parameter lives here, so the agent can be retuned and
# re-measured with `python -m evals.run` without touching the code.
# The values below are the defaults the evaluation scenarios were written against.

# ---------------------------------------------------------------- model
# Required for the CLI, the web UI and the evals. The tests do not need it.
OPENAI_API_KEY=sk-...

# Any OpenAI model that supports tool calling.
AGENT_MODEL=gpt-5.6-luna

# Reasoning models generally require temperature 1.
AGENT_TEMPERATURE=1

# minimal | low | medium | high. Leave blank for models that do not support it;
# it is only sent when set.
AGENT_REASONING_EFFORT=low

# ---------------------------------------------------------------- clock and data
# A fixed ISO 8601 timestamp, or `auto` for the system clock.
# Pinning it keeps evaluation runs reproducible. Either way each mock world is
# rebased so its incident day is the day before this time, and "yesterday
# afternoon" always finds the data.
AGENT_NOW=2026-09-23T10:00:00Z

# incident | healthy | ambiguous | upstream
AGENT_WORLD=incident

# Where the prompt files live. Defaults to the prompts/ directory in this repo.
# AGENT_PROMPTS_DIR=prompts

# ---------------------------------------------------------------- budgets
# Raising these buys more investigation for more money.
# Cost bound per turn is AGENT_MAX_LLM_STEPS + 1 model calls.
AGENT_MAX_LLM_STEPS=10
AGENT_MAX_TOOL_CALLS=12

# Consecutive results that taught the model nothing before the loop gives up.
AGENT_STUCK_THRESHOLD=3

AGENT_TOOL_TIMEOUT_S=2.0
AGENT_TOOL_RETRIES=1

# Attempts the model gets to fix an invalid final response before it is
# returned marked unverified.
AGENT_REPAIR_ATTEMPTS=1

# ---------------------------------------------------------------- result limits
# Rows of tool data sent to the model. Summaries always use the full result.
AGENT_MAX_ROWS=20

# Largest window a data tool will accept.
AGENT_MAX_WINDOW_DAYS=7

# ---------------------------------------------------------------- spike detection
# A point is a spike above max(multiplier x baseline, baseline + the metric's
# minimum difference). Lower the multiplier to make the agent more sensitive.
AGENT_SPIKE_MULTIPLIER=3

# Fewer points than this and no spike claim is made.
AGENT_MIN_METRIC_POINTS=5
