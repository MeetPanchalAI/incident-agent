# Required to run the CLI, the API, or the evaluation suite.
# Not required by the automated tests.
OPENAI_API_KEY=sk-...

# Any OpenAI model that supports tool calling.
AGENT_MODEL=gpt-4.1-mini

# The agent's "current time". All mock data is anchored to it.
AGENT_NOW=2026-09-23T10:00:00Z

# Which mock world the tools read from: incident | healthy | ambiguous | upstream
AGENT_WORLD=incident
